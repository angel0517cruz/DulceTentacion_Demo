<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DulceTentacion</AssemblyName>
    <RootNamespace>DulceTentacion</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <!-- El esquema viaja dentro de la aplicación: se aplica solo al arrancar. -->
  <ItemGroup>
    <EmbeddedResource Include="Infra\esquema.sql" LogicalName="esquema.sql" />
  </ItemGroup>

</Project>
